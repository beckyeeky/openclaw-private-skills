#!name = Example Request+Response
#!desc = 请求清洗 + 被动响应探针骨架；请替换真实 API 和 script-path
#!author = you
#!homepage = https://github.com/USER/REPO
#!icon = https://www.example.com/favicon.ico
#!tag = example,script
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(978)
#!type = normal

[Argument]
mode = select,"scrub","origin",tag=模式,desc=scrub=清洗 | origin=关闭
notify = switch,true,tag=异常通知,desc=响应业务异常时通知

[Script]
http-request ^https:\/\/api\.example\.com\/v1\/feed script-path=https://raw.githubusercontent.com/USER/REPO/main/scripts/example-request.js,requires-body=false,binary-body-mode=false,timeout=10,tag=Example Request,argument=[{mode}]
http-response ^https:\/\/api\.example\.com\/v1\/feed script-path=https://raw.githubusercontent.com/USER/REPO/main/scripts/example-response.js,requires-body=true,binary-body-mode=false,timeout=10,tag=Example Observe,argument=[{notify}]

[Mitm]
hostname = api.example.com
