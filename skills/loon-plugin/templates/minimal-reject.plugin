#!name = Example Rewrite V2 Reject
#!desc = Loon 3.5.1 (978)+ 最小拒绝示例；请替换真实域名和路径
#!author = you
#!homepage = https://github.com/USER/REPO
#!icon = https://www.example.com/favicon.ico
#!tag = example,rewrite-v2
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(978)
#!type = normal

[Rewrite]
http-request if ${url} ~= /^https?:\/\/api\.example\.com\/(?:ad|ads|splash)\// then reject(status=200, body="empty")

[Mitm]
hostname = api.example.com
